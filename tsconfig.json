{
  "compilerOptions": {
    "noEmit": true,
    "target": "es2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "outDir": "./dist"
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.d.ts",
    "./tests/**/*.ts",
    "./tests/**/*.d.ts"
  ],
  "exclude": [
    "./node_modules",
    "dist"
  ]
}
